# TLS for the tracker's name, and every request handed to the tracker. The MCP transport streams, so nothing is
# buffered and idle connections are left alone: flush_interval -1 streams each response as it is written.
# No trusted_proxies, on purpose: Caddy then ignores a client's own X-Forwarded-* headers and writes the client's
# address itself, which is what the tracker's rate limits and the witness's address binding read (QX-18 section 7).
# A proxy put in front of Caddy is named here in trusted_proxies and in QUILT_TRUSTED_PROXIES both.
# The second peer lives under the same name (docs/DEPLOY.md, "The second peer"): the second door at /two/ and the
# relay at /relay, each handed the path past its prefix, since the host's firewall admits 80 and 443 alone.
# The iPhone app opens a square's page (docs/DEPLOY.md, "The public door"): Apple reads the file below to learn that
# the app org.bitquilt.quilt of the team 8PB5R5CS37 may open the pages under /r/ on this name. Caddy answers it
# itself, since it says something of this host and its app and nothing of the tracker.
tracker.bitquilt.org {
    encode zstd gzip
    handle /.well-known/apple-app-site-association {
        header Content-Type application/json
        respond `{"applinks":{"details":[{"appIDs":["8PB5R5CS37.org.bitquilt.quilt"],"components":[{"/":"/r/*"}]}]}}`
    }
    handle_path /two/* {
        reverse_proxy tracker-two:3977 {
            flush_interval -1
        }
    }
    handle_path /relay* {
        reverse_proxy relay:7777
    }
    handle {
        reverse_proxy tracker:3977 {
            flush_interval -1
        }
    }
}
