# The public tracker's environment: copy to deploy/.env on the host and fill in. Names only here; docs/DEPLOY.md says what each is.
QUILT_URL=https://tracker.bitquilt.org/
QUILT_NAME=BitQuilt
QUILT_KEY_SECRET=                 # openssl rand -hex 32, made once and kept in two places: every hosted key is lost without it
QUILT_IP_SALT=                    # openssl rand -hex 16
QUILT_OAUTH_SECRET=               # openssl rand -hex 32, kept: signs the authorization server's tokens (QX-18); empty, no OAuth and no witness
QUILT_OAUTH_ISSUER=               # the issuer the OAuth metadata names; empty, the tracker's address without its trailing slash
QUILT_WITNESS_RANGES=             # the address ranges each product publishes, as JSON {"claude.ai":["160.79.104.0/21"]}; empty, the ranges in products.ts
QUILT_TRUSTED_PROXIES=            # the proxies whose X-Forwarded-For is believed, ranges comma separated; empty, the private networks Caddy is on
QUILT_MAINTAINERS=                # the maintainers' addresses, comma separated (quilt init on a machine they trust; the phrase kept offline)
QUILT_FIRST_SEEDER=               # one address whose seeded problems a key with no accepted work is offered first (QX-5 section 2); none when empty
QUILT_FOUNDING_STANDING=          # a founding standing declared per root, <address>=<amount> comma separated (QX-1 section 2 as amended): the public tracker declares 400 for the maintainers' root
QUILT_COIN=                       # the parameters as one JSON object, from docs/LAUNCH.md, with genesis a day or two ahead and the treasury root filled in
QUILT_PEERS=https://tracker.bitquilt.org/two/        # the second door on this host; the two fold each other's chains every five minutes (QX-21)
QUILT_RELAYS=wss://tracker.bitquilt.org/relay        # the host's own relay (QX-14), given to the members' Quilts to announce and search on
TWO_URL=https://tracker.bitquilt.org/two/            # the origin the second door says it is (docs/DEPLOY.md, "The second peer")
TWO_NAME=BitQuilt, second door
QUILT_LIMIT_KEY_HOUR=120
QUILT_LIMIT_IP_HOUR=600
QUILT_STAMP_NAME=0
# The house second opinion (docs/DEPLOY.md, "The house second opinion"): the house and house-openai services read these and
# nothing else above. The tracker reads the whole file, so its owners' turn asks for the sentence a brief lacks with the
# same vendor key (docs/DEPLOY.md, "The public door").
HOUSE_VENDOR=anthropic            # whose model the house answers with: anthropic (a Claude API key) or openai
ANTHROPIC_API_KEY=                # the house's key at Anthropic, read when HOUSE_VENDOR is anthropic; empty, the service runs nothing and says so in its log
OPENAI_API_KEY=                   # the key at OpenAI of the second house (house-openai), and of the house where HOUSE_VENDOR is openai; empty, a house on OpenAI runs nothing
HOUSE_OPENAI_MODEL=gpt-6-luna     # the model the second house answers with; every reveal of its is declared openai/<this>
HOUSE_MODEL=claude-opus-5-5       # the model the house answers with (gpt-6-luna for openai); every reveal is declared <vendor>/<this>
HOUSE=on                          # off switches both houses off, and on switches both on, once both services are brought up again (docker compose up -d house house-openai)
