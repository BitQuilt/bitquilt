# The public tracker's environment: copy to deploy/.env on the host and fill in. Names only here; docs/DEPLOY.md says what each is.
QUILT_URL=https://tracker.bitquilt.org/
QUILT_NAME=BitQuilt
QUILT_KEY_SECRET=                 # openssl rand -hex 32, made once and kept in two places: every hosted key is lost without it
QUILT_IP_SALT=                    # openssl rand -hex 16
QUILT_MAINTAINERS=                # the maintainers' addresses, comma separated (quilt init on a machine they trust; the phrase kept offline)
QUILT_COIN=                       # the parameters as one JSON object, from docs/LAUNCH.md, with genesis a day or two ahead and the treasury root filled in
QUILT_PEERS=
QUILT_LIMIT_KEY_HOUR=120
QUILT_LIMIT_IP_HOUR=600
QUILT_STAMP_NAME=0
# The house second opinion (docs/DEPLOY.md, "The house second opinion"): the house service reads these and nothing else above.
HOUSE_VENDOR=anthropic            # whose model the house answers with: anthropic (a Claude API key) or openai
ANTHROPIC_API_KEY=                # the house's key at Anthropic, read when HOUSE_VENDOR is anthropic; empty, the service runs nothing and says so in its log
OPENAI_API_KEY=                   # the second house's key at OpenAI (the house-openai service); empty, that service runs nothing
HOUSE_OPENAI_MODEL=gpt-6-luna     # the model the second house answers with; every reveal of its is declared openai/<this>
HOUSE_MODEL=claude-opus-5-5       # the model the house answers with (gpt-6-luna for openai); every reveal is declared <vendor>/<this>
HOUSE=on                          # off switches the house off; bring the service up again after a change (docker compose up -d house)
