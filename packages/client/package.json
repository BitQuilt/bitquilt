{
  "name": "quilt",
  "version": "0.2.1",
  "description": "Quilt: the thing a person opens. One program that is the MCP server your AI connects to, a page on localhost with search, publish and a library, and a node that serves what it holds.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "quilt": "./src/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/bin.ts"
  },
  "dependencies": {
    "@bitquilt/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bitquilt/mirror": "workspace:*",
    "@bitquilt/tracker": "workspace:*",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  }
}
