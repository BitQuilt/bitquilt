{
  "name": "@bitquilt/hosted",
  "version": "0.1.0",
  "description": "The hosted on-ramp: a tracker with Quilt's connector mounted beside it, holding a key for anyone who cannot run Quilt, reachable at an address they paste into their AI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "bitquilt-hosted": "./src/bin.ts" },
  "exports": { ".": { "types": "./src/index.ts", "import": "./src/index.ts" } },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/bin.ts"
  },
  "dependencies": {
    "@bitquilt/core": "workspace:*",
    "@bitquilt/tracker": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "quilt": "workspace:*"
  }
}
