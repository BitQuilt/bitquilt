{
  "name": "bitquilt",
  "private": true,
  "version": "0.0.0",
  "description": "BitQuilt: a torrent where the pieces are made, not copied. The core library, the reference tracker and Quilt, the client.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "conform": "pnpm --filter @bitquilt/core conform",
    "build:bin": "node scripts/build-binaries.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@anthropic-ai/sdk": "1.3.0",
    "@types/node": "22.19.21",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tmp": "^0.2.7",
      "node-forge": "^1.4.2"
    }
  }
}
