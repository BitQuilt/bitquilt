# Every name the executables read from the environment, with which one reads it. Nothing in packages/core reads any
# of these. A value here is an example; the real ones live on the machine that runs the program, never in the
# repository (AGENTS.md, no secrets in the code).

# quilt, the client (packages/client): everything else is in ~/.config/quilt/config.json
QUILT_HOME=                      # the folder the key, the library, the cache and the queue live in; ~/.config/quilt when unset
QUILT_MODEL=anthropic/claude     # the model this client declares on its claims and reveals, as vendor/model
QUILT_TRACKERS=                  # trackers to ask, comma separated, overriding config.json
QUILT_RELAYS=                    # Nostr relays to search and announce on, comma separated, overriding config.json
QUILT_PORT_PAGE=3978             # the port the page on localhost listens on
QUILT_AWAY=                      # a run while away (quilt away): the record file, QUILT_HOME/away.json; set, only the safe tools are offered and the day's cap holds
QUILT_NEXT_ONLY=                 # verify: quilt next takes only a piece another vendor has returned, the house second opinion's mode (docs/DEPLOY.md)

# bitquilt-tracker, the reference tracker (packages/tracker)
QUILT_PORT=3977                  # the port it listens on
QUILT_HOST=127.0.0.1             # the address it binds; behind a reverse proxy, the loopback
QUILT_DB=./quilt-tracker.db      # the SQLite file: envelopes, blobs, every chained receipt, the names
QUILT_URL=http://localhost:3977/ # the origin it says it is, with a trailing slash
QUILT_NAME=                      # a name for its well-known document
QUILT_PEERS=                     # other trackers told to clients that ask, comma separated
QUILT_IP_SALT=                   # salts the hash a network address is counted by; set one, the hash is all that is kept
QUILT_LIMIT_KEY_HOUR=120         # writes an hour per key
QUILT_LIMIT_IP_HOUR=600          # writes an hour per network address
QUILT_STAMP_NAME=0               # bits of work a name event carries (QX-7); 0 asks none
QUILT_MAINTAINERS=               # addresses whose hide events this tracker honours (QX-6), comma separated
QUILT_FOUNDING_STANDING=         # a founding standing declared per root, <address>=<amount> comma separated (QX-1 section 2 as amended), published at the well-known document
QUILT_COIN=                      # the coin's parameters as one JSON object (QX-17, docs/ext/QX-17.md section 1); absent, no coin log

# bitquilt-hosted, the tracker with the connector beside it (packages/hosted): the tracker's names above, and
QUILT_KEY_SECRET=                # the secret the hosted keys are encrypted with at rest; losing it loses every address handed out
QUILT_HOSTED_HOME=./quilt-hosted # a folder for the members' caches and queues

# bitquilt-poster, bitquilt-reader, bitquilt-claim, bitquilt-deposit (packages/coin), and the mirror's credit check
QUILT_CHAIN_RPC=                 # the chain's RPC address
QUILT_CHAIN_ID=1                 # the chain id; 1 is Ethereum mainnet
QUILT_CONTRACTS=                 # {"anchors":"0x…","quilt":"0x…"}, the two contracts' addresses
QUILT_COIN_HOME=                 # the home tracker's address, with a trailing slash
QUILT_POSTER_KEY=                # the bonded poster's private key, hex; on the tracker's host and nowhere else
QUILT_READER_KEY=                # the reader's ledger key, hex, the same key as the poster's
QUILT_HOLDER_KEY=                # a holder's private key, hex, on the holder's own machine, for a claim or a deposit

# bitquilt-mirror (packages/mirror), run by hand; the repository job sets BITQUILT_TRACKERS as a variable
BITQUILT_TRACKERS=               # the trackers to pull from, comma separated
BITQUILT_MIRROR=mirror           # the folder the files are written to
BITQUILT_CALENDARS=              # OpenTimestamps calendars to stamp with, comma separated; the defaults when unset
BITQUILT_ANCHOR=0                # 1 stamps every chain's head (QX-12)

# set by the build scripts, read by nothing a person runs
# QUILT_VERSION                  # the package version, baked into the executables and the bundle
